<?xml version="1.0" encoding="utf-8"?>
<!--
  图标是一张照片，所以直接铺在背景层上 —— 自适应图标的三层都是 108x108dp，
  遮罩只露出中间那块（圆形约 2/3），图片按中心对齐正好。

  前景层留透明：内容全在背景层，前景再加东西只会在某些启动器里被 parallax 推偏。
  没有 monochrome（主题图标）：一张照片没有合理的单色版本。
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_cat" />
    <foreground android:drawable="@android:color/transparent" />
</adaptive-icon>
