<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 打开签到页 / 加载 WebView 需要 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 扫码需要。声明为非必需，没摄像头的设备也能装 —— 粘贴链接那条路照样能用 -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- 签到要带上 GPS 坐标。
         不给也能签成功，但教师端后台那一列会是空的（实测过：服务端会解析这个值、
         认坐标格式，只是解析失败照样放行），一眼就能看出这几条和别人的不一样。
         所以声明为非必需：用户拒绝授权时照常签到，只是没有坐标。 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <!-- CameraX 的清单会把 android.hardware.camera 合并成 required=true，
         导致没摄像头的平板/Chromebook 装不上。这个 App 的核心能力
         （粘贴链接 → 生成二维码）根本不需要相机，所以显式改回非必需。 -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false"
        tools:replace="android:required" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CAU_class_checker">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.CAU_class_checker"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 严格模式要拍照。`ACTION_IMAGE_CAPTURE` 只接受 content:// 地址，
             所以得有个 FileProvider 把 cacheDir 里的临时文件暴露出去。
             照片拍完就压缩上传，不写相册 —— 那是签到的中间产物，没理由留在用户相册里。 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
